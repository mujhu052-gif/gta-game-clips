# YTClip Frontend Build Environment Configuration
# For local single-server dev (server.ts serving Vite + /api on port 3000), leave empty to use relative /api.
# For production separate frontend/backend hosting (e.g. https://YOUR-DOMAIN.com -> https://api.YOUR-DOMAIN.com),
# set VITE_API_BASE_URL to your public HTTPS API endpoint before running `npm run build`.
VITE_API_BASE_URL=""

# Optional maximum upload file size displayed in UI (must be <= backend MAX_UPLOAD_MB)
VITE_MAX_UPLOAD_MB="1024"
