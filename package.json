    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.5",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.5.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.6",
